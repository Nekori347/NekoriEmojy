+def finish_material_move(window):
+    """End only this HWND's temporary policy; never create a window handle."""
+    state = getattr(window, '_material_move', None)
+    window._material_move = None
+    if state and state[1] == 'active' and int(window.internalWinId()) == state[0]:
+        native_material(window, overlay=state[2])
+
+
+def material_move_message(window, message, wparam=0):
+    """Win10 candidate: SC_MOVE arms; size loops alone never change material."""
+    if sys.platform != 'win32' or not 17763 <= sys.getwindowsversion().build < 22000:
+        return
+    hwnd = int(window.internalWinId())
+    state = getattr(window, '_material_move', None)
+    if state and state[0] != hwnd:
+        window._material_move = state = None
+    if message == 0x112:
+        command = int(wparam) & 0xfff0
+        if command != 0xf010:
+            finish_material_move(window)
+        elif state is None and hwnd and window.property('nativeMaterial') == 'acrylic':
+            key = getattr(window, '_material_key', ())
+            window._material_move = (hwnd, 'armed', bool(key[-1]) if key else False)
+    elif message == 0x231 and state and state[1] == 'armed':
+        window._material_move = (hwnd, 'active', state[2])
+        if native_material(window, overlay=state[2]) != 'opaque':
+            window._material_move = None  # Native rejection: no pretend downgrade or retry loop.
+    elif message in (0x232, 0x1f):
+        finish_material_move(window)
 
 
